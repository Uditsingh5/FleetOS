{
  "name": "waterfleet-os-server",
  "version": "1.0.0",
  "description": "WaterFleetOS - Water Scarcity Response, Fleet Tracking & Emergency Distribution Platform",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/seed.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --forceExit --detectOpenHandles",
    "demo:drivers": "node scripts/simulate-drivers.js",
    "lint": "eslint src/",
    "format": "prettier --write src/"
  },
  "keywords": [
    "water",
    "fleet",
    "tracking",
    "emergency"
  ],
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.0",
    "multer": "^1.4.5-lts.1",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "socket.io": "^4.8.0",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "eslint": "^9.11.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3"
  }
}
